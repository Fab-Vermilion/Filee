# Build output
bin/
obj/
artifacts/
publish/
Releases/

# Downloaded conversion engines (see build/fetch-engines.ps1)
engines/
build/.cache/

# IDE
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo
*.DotSettings.user

# Local Web development state (uploads, work dirs, output, job database, logs)
.filee-web/

# Test results
TestResults/
*.trx
coverage*/

# This fork ships only the Web application. Upstream docs/tests are not part of it
# and may carry environment-specific details: keep them local, not in the release.
docs/
tests/

# macOS AppleDouble companion files on exFAT volumes (interfere with git/build)
._*

# OS
Thumbs.db
.DS_Store

# Local real credentials (never commit)
Client_profile
appsettings.local.json

# Fonts are downloaded by build/fetch-fonts.ps1
src/Filee.App/Assets/Fonts/*.ttf
src/Filee.App/Assets/Fonts/*.otf

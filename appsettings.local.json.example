{
  "_readme": [
    "复制本文件为 appsettings.local.json 后按实际环境填写；该文件已被 gitignore，不会进代码库。",
    "所有 *.example.com 与 <...> 都是占位示例，必须替换成真实值，否则服务无法启动或免登失败。",
    "监听地址与免登回调地址必须同域名同端口，且与 WorkBuddy 控制台登记值完全一致。",
    "启动：项目根目录执行 ./start.sh；环境变量优先级高于本文件。",
    "密钥为明文存储，请勿提交或随部署包分发；如需保密请改用 Docker secret 等密钥管理服务。"
  ],
  "Server": {
    "urls": "https://filee.example.com:18799",
    "redirectUri": "https://filee.example.com:18799/sso"
  },
  "Sso": {
    "issuer": "https://sso.example.com/tenant/<tenant-id>",
    "audience": "<Client ID>",
    "clientId": "<Client ID>",
    "clientSecret": "<Client Secret>",
    "allowedRedirectOrigins": [],
    "wellKnownPath": "/.well-known/openid-configuration",
    "clockSkewMinutes": 5
  },
  "Session": {
    "lifetimeHours": 8
  },
  "Retention": {
    "fileAndRecordHours": 24,
    "downloadTokenHours": 24,
    "cleanupIntervalHours": 1
  },
  "Storage": {
    "root": ".filee-web"
  },
  "Limits": {
    "maxFileBytes": 524288000,
    "maxConcurrency": 4,
    "sseThrottleMs": 150,
    "sseBufferSize": 200,
    "sseHeartbeatSeconds": 15,
    "loWorkers": 1
  },
  "Tls": {
    "pfxPath": ".filee-web/certs/localhost.pfx",
    "password": "<证书密码>"
  },
  "opsToken": ""
}

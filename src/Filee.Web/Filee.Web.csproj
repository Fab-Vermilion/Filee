<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Filee.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filee.Core\Filee.Core.csproj" />
    <ProjectReference Include="..\Filee.Engines\Filee.Engines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <!-- Deployment never ships a database; it is created on first run or via init-db.sh. -->
  <ItemGroup>
    <Content Remove="**/*.db" />
    <None Remove="**/*.db" />
    <Content Remove="appsettings.local.json" />
    <None Remove="appsettings.local.json" />
  </ItemGroup>
</Project>
